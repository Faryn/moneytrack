[Unit]
Description=Verified MoneyTrack SQLite snapshot
After=moneytrack.service

[Service]
Type=oneshot
User=moneytrack
Group=moneytrack
ExecStart=/usr/bin/python3 /opt/moneytrack/backup.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/moneytrack /var/lib/moneytrack
