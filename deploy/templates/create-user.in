#!/usr/bin/env python3
"""Create an administrator-provisioned account in the application-host release."""
import getpass
import re
import shlex
import subprocess
import sys

if len(sys.argv) != 2 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{2,31}", sys.argv[1]):
    sys.exit("Usage: python3 deploy/create-user USERNAME")
password = getpass.getpass("Password (12–72 bytes): ")
if password != getpass.getpass("Confirm password: "):
    sys.exit("Passwords differ; no account created.")
command = [
    "sudo", "-n", "docker", "exec", "-i", "-e",
    "MONEYTRACK_USERNAME=" + sys.argv[1], "moneytrack-web-1",
    "/app/bin/moneytrack", "eval",
    'MoneyTrack.Release.create_user(System.fetch_env!("MONEYTRACK_USERNAME"))',
]
subprocess.run(["ssh", "-T", "@@APP_SSH@@", shlex.join(command)], input=password, text=True, check=True)
