#!/bin/sh
set -eu
# Affect this application's listener only; run before Tailscale's accept rule.
app_ip=192.0.2.10
proxy_ip=192.0.2.20
port=4018
chain=MONEYTRACK_IN
if ! iptables -w -n -L "$chain" >/dev/null 2>&1; then
  iptables -w -N "$chain"
fi
for source in "$proxy_ip" "$app_ip"; do
  if ! iptables -w -C "$chain" -s "$source" -j ACCEPT 2>/dev/null; then
    iptables -w -A "$chain" -s "$source" -j ACCEPT
  fi
done
if ! iptables -w -C "$chain" -j DROP 2>/dev/null; then
  iptables -w -A "$chain" -j DROP
fi
while iptables -w -C INPUT -d "$app_ip" -p tcp --dport "$port" -j "$chain" 2>/dev/null; do
  iptables -w -D INPUT -d "$app_ip" -p tcp --dport "$port" -j "$chain"
done
iptables -w -I INPUT 1 -d "$app_ip" -p tcp --dport "$port" -j "$chain"
