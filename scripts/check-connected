#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python3 - <<'PY'
import socket
with socket.socket() as sock:
    try:
        sock.bind(('127.0.0.1', 4004))
    except OSError:
        raise SystemExit('Port 4004 is already in use; stop that development server before running this check.')
PY
connected_dir=$(mktemp -d "${TMPDIR:-/tmp}/moneytrack-connected.XXXXXX")
export MONEYTRACK_CONNECTED_ROOT="$connected_dir"
export MONEYTRACK_DATA_DIR="$connected_dir/server"
export MONEYTRACK_TEST_DATABASE_PATH="$connected_dir/test.sqlite3"
unset DATABASE_PATH
unset MIX_ENV
export MONEYTRACK_TEST_SERVER=http://127.0.0.1:4004
export MONEYTRACK_CONNECTED_FIXTURES=1
export PORT=4004
export MONEYTRACK_DERIVED_DATA=${MONEYTRACK_DERIVED_DATA:-$connected_dir/DerivedData}
export MONEYTRACK_TEST_RESULTS=${MONEYTRACK_TEST_RESULTS:-$connected_dir/MoneyTrack.xcresult}
server_pid=
cleanup() {
  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM
printf 'Isolated connected check: %s\n' "$connected_dir"
cd "$repo_dir/server"
"$repo_dir/scripts/check-server" > "$connected_dir/server-check.log" 2>&1
mix ecto.migrate > "$connected_dir/migration.log" 2>&1
mix run test/support/setup_connected.exs > "$connected_dir/fixtures.log" 2>&1
mix phx.server > "$connected_dir/server.log" 2>&1 &
server_pid=$!
python3 - <<'PY'
import time, urllib.request
for _ in range(120):
    try:
        with urllib.request.urlopen('http://127.0.0.1:4004/api/health', timeout=1) as response:
            if response.status == 200: break
    except Exception:
        time.sleep(0.25)
else:
    raise SystemExit('The isolated server did not start; inspect server.log in the check directory.')
PY
cd "$repo_dir"
if ! scripts/test-ios > "$connected_dir/ios-check.log" 2>&1; then
  tail -n 35 "$connected_dir/ios-check.log"
  exit 1
fi
python3 - "$connected_dir/ios-check.log" <<'PY'
import pathlib, re, sys
log = pathlib.Path(sys.argv[1]).read_text()
for name in ['testRealServerRetryConflictDeletionAndExpiredSessionRecovery', 'testRealServerEmailVerificationRequestRetryAndRejectedCode', 'testExplicitCopyLoginSyncAndKeychainRelaunch', 'testTwoAccountsShareSettleConflictDeleteAndKeepPrivateCategories']:
    if not re.search(r'Test Case .*' + name + r'.* passed', log):
        raise SystemExit('The real-server test did not pass (or was skipped): ' + name)
print('Server checks, real native API integration, and connected simulator UI checks passed.')
PY
